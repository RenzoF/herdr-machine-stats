#!/usr/bin/env python3
"""Live stats for this machine and every machine Herdr has saved.

machine-stats [--interval SECONDS] [--once] [--deploy MODE]
              [--pipeline URL]

One card per machine: CPU, memory and disk gauges, a CPU history
sparkline, load, Herdr agents by status, and whether this plugin is
installed there. Keys: arrows or h/j/k/l move between cards, Enter opens
btop on the selected machine, d deploys this plugin to the selected
machine (deploy = "ask"), r refreshes now, q quits. --once prints a plain
table and exits. Reads are read-only; the only thing ever installed on
another machine is this plugin, by a deploy you turned on (--deploy or
config.toml; the default is off). With a dispatcher URL (--pipeline or
pipeline_url in config.toml) one more read-only card shows that pipeline.
"""
import argparse
import curses
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from statslib import (  # noqa: E402
    PLUGIN_ID, collect, config, deploy, herdr, local_version, pipeline,
    render)

ENTER_KEYS = (10, 13, curses.KEY_ENTER)
# Style name -> (256-colour foreground, 8-colour fallback, extra attribute).
PALETTE = {
    "green": (114, curses.COLOR_GREEN, 0),
    "yellow": (221, curses.COLOR_YELLOW, 0),
    "red": (203, curses.COLOR_RED, 0),
    "blue": (75, curses.COLOR_BLUE, 0),
    "spark": (80, curses.COLOR_CYAN, 0),
    "border": (240, curses.COLOR_WHITE, 0),
    "selected": (51, curses.COLOR_CYAN, curses.A_BOLD),
    "title": (255, curses.COLOR_WHITE, curses.A_BOLD),
    "dim": (243, curses.COLOR_WHITE, curses.A_DIM),
    "bar": (16, curses.COLOR_BLACK, curses.A_BOLD),
}


def load_machines():
    """Saved machines and a note, or no machines and why."""
    try:
        return collect.parse_machines(herdr.machine_list_text()), None
    except herdr.HerdrError as exc:
        return [], f"machine-stats: herdr machine list failed: {exc}"


def deploy_mode(override):
    """The deploy mode for this run, and a note when it fell back to off."""
    if override:
        return override, None
    try:
        return config.load(herdr.config_dir(PLUGIN_ID))
    except herdr.HerdrError as exc:
        return "off", f"no plugin config dir ({exc}); deploy is off"


def pipeline_url(override):
    """The dispatcher URL for this run ("" for none), and a note."""
    if override is not None:
        if override and not pipeline.valid_url(override):
            return "", f"--pipeline {override!r} is not an http(s) URL"
        return override, None
    try:
        return config.load_pipeline_url(herdr.config_dir(PLUGIN_ID))
    except herdr.HerdrError:
        return "", None  # deploy_mode already says there is no config dir


def join_notes(*notes):
    return "; ".join(n for n in notes if n) or None


class Poller:
    """Polls every machine in the background; the view never blocks."""

    def __init__(self, interval, url=""):
        self.interval = interval
        self.watcher = pipeline.Watcher(url, interval) if url else None
        self.lock = threading.Lock()
        self.wake = threading.Event()
        self.history = render.History()
        self.rows, self.targets, self.note, self.updated = None, [], None, ""
        self.polled = None  # time.monotonic() when the latest poll began
        threading.Thread(target=self.loop, daemon=True).start()

    def loop(self):
        while True:
            began = time.monotonic()
            found, note = load_machines()
            rows = collect.poll(socket.gethostname(), found)
            with self.lock:
                self.history.record(rows)
                self.rows = rows
                self.targets = [None, *(m.target for m in found)]
                self.note = note
                self.updated = time.strftime("%H:%M:%S")
                self.polled = began
            self.wake.wait(self.interval)
            self.wake.clear()

    def view(self):
        with self.lock:
            return (self.rows, self.targets, self.note, self.updated,
                    self.polled)

    def pipeline(self):
        """The latest pipeline.View, None before the first read or when
        no dispatcher is configured."""
        return self.watcher.view() if self.watcher else None

    def refresh(self):
        self.wake.set()
        if self.watcher:
            self.watcher.refresh()


def start_colors():
    """Style name -> curses attribute, as colourful as the terminal allows."""
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    styles = {name: extra for name, (_c, _f, extra) in PALETTE.items()}
    if not curses.has_colors():
        styles["selected"] = curses.A_REVERSE
        return styles
    curses.start_color()
    try:
        curses.use_default_colors()
        background = -1
    except curses.error:
        background = curses.COLOR_BLACK
    rich = curses.COLORS >= 256
    for pair, (name, (full, basic, extra)) in enumerate(
            PALETTE.items(), start=1):
        back = background
        if name == "bar":  # the title bar: dark text on cyan
            back = 80 if rich else curses.COLOR_CYAN
        curses.init_pair(pair, full if rich else basic, back)
        styles[name] = curses.color_pair(pair) | extra
    return styles


def put(screen, y, x, text, attr=0):
    """Write within the screen; curses refuses the bottom-right cell."""
    height, width = screen.getmaxyx()
    if 0 <= y < height and x < width:
        try:
            screen.addnstr(y, x, text, width - x, attr)
        except curses.error:
            pass


def draw(screen, styles, interval, poller, view, selected, notes=None,
         message=None):
    rows, _targets, note, updated, _polled = view
    height, width = screen.getmaxyx()
    screen.erase()
    status = render.summary(rows) if rows else "polling..."
    title = (f" machine stats  {updated or '--:--:--'}  {status}"
             f"  every {interval:g}s")
    put(screen, 0, 0, title.ljust(width), styles["bar"])
    keys = " arrows move  Enter btop  d deploy  r refresh  q quit"
    footer = message or note
    if footer:
        keys += f"   {footer}"
    put(screen, height - 1, 0, keys, styles["dim"])
    if not rows:
        screen.refresh()
        return
    extra = poller.watcher is not None
    columns, card_width = render.grid(len(rows) + extra, width)
    visible = max(1, (height - 2) // render.CARD_HEIGHT)
    first = max(0, selected // columns - visible + 1) * columns
    with poller.lock:
        cards = [render.card(row, poller.history, card_width, i == selected,
                             note=notes[i] if notes else None)
                 for i, row in enumerate(rows)]
        if extra:
            cards.append(render.pipeline_card(poller.pipeline(), card_width))
    for i, lines in enumerate(cards[first:first + visible * columns]):
        top = 1 + (i // columns) * render.CARD_HEIGHT
        left = (i % columns) * card_width
        for n, line in enumerate(lines):
            x = left
            for text, style in line:
                put(screen, top + n, x, text, styles.get(style, 0))
                x += len(text)
    screen.refresh()


def dashboard(screen, interval, mode, mode_note, url=""):
    styles = start_colors()
    screen.timeout(250)
    poller = Poller(interval, url)
    deployer = deploy.Deployer()
    version = local_version()
    selected, attempted = 0, set()
    prompt, message = None, mode_note
    while True:
        view = poller.view()
        rows, targets = view[0] or [], view[1]
        selected = render.step(selected, 0, max(len(rows), 1))
        here = rows[0].snapshot.plugin if rows and rows[0].snapshot else None
        picks = (deploy.auto_targets(rows, targets, version, attempted)
                 if mode == "auto" else [])
        attempted.update(label for label, _target in picks)
        start_deploys(deployer, here, picks)
        notes = [notes_for(row, i == 0, version, deployer, view[4])
                 for i, row in enumerate(rows)]
        if prompt:
            message = f"deploy {version} to {prompt[0]}? y/n"
        draw(screen, styles, interval, poller, view, selected, notes,
             message)
        key = screen.getch()
        if prompt and key != -1:
            label, target = prompt
            prompt, message = None, None
            if key == ord("y"):
                start_deploys(deployer, here, [(label, target)])
            continue
        columns = render.grid(max(len(rows), 1) + bool(url),
                              screen.getmaxyx()[1])[0]
        moves = {curses.KEY_RIGHT: 1, ord("l"): 1, curses.KEY_LEFT: -1,
                 ord("h"): -1, curses.KEY_DOWN: columns, ord("j"): columns,
                 curses.KEY_UP: -columns, ord("k"): -columns}
        if key in (ord("q"), 27):
            return
        if key == ord("r"):
            poller.refresh()
        elif key == ord("d") and rows:
            message = ask_deploy(mode, rows, selected, version)
            if message is None:
                prompt = (rows[selected].label, targets[selected])
        elif key in moves and rows:
            selected = render.step(selected, moves[key], len(rows))
        elif key in ENTER_KEYS and rows and rows[selected].snapshot:
            curses.def_prog_mode()
            curses.endwin()
            subprocess.run(collect.drill_argv(targets[selected]))
            curses.reset_prog_mode()
            screen.clear()


def notes_for(row, is_here, version, deployer, polled=None):
    """The plugin line for one card; this machine is always current.

    ``polled`` is when the poll behind ``row`` began.
    """
    if row.snapshot is None:
        return None
    entry = row.snapshot.plugin
    state = "current" if is_here and entry else deploy.plugin_state(
        version, entry)
    return render.plugin_note(state, entry, deployer.get(row.label, polled))


def ask_deploy(mode, rows, selected, version):
    """None to prompt for the selected card, or the reason not to."""
    if mode != "ask":
        return ("deploy is off; set deploy = \"ask\" in config.toml"
                if mode == "off" else "deploy is automatic in auto mode")
    if selected == 0:
        return "this machine runs the plugin already"
    snap = rows[selected].snapshot
    if snap is None:
        return f"{rows[selected].label} is down"
    state = deploy.plugin_state(version, snap.plugin)
    if not deploy.deployable(state, snap.plugin):
        return f"nothing to deploy: plugin {state}" + (
            " (linked checkout)" if deploy.linked(snap.plugin) else "")
    return None


def start_deploys(deployer, here, picks):
    """Deploy this machine's plugin ``here`` to each (label, target).

    Everything slow, including the lookup of the commit, runs in the
    deployer's threads; a refusal shows on the card.
    """
    for label, target in picks:
        deployer.start(label, target, here)


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="machine-stats",
        description="Live stats for every Herdr machine.")
    parser.add_argument("--interval", type=float, default=10,
                        help="seconds between polls (default 10)")
    parser.add_argument("--once", action="store_true",
                        help="print the table once and exit")
    parser.add_argument("--deploy", choices=config.MODES,
                        help="deploy mode for this run (default: config)")
    parser.add_argument("--pipeline", metavar="URL",
                        help="the dispatcher's /status, for the pipeline "
                        "card (default: pipeline_url in config; '' for "
                        "none)")
    args = parser.parse_args(argv)
    if args.interval < 1:
        parser.error("--interval must be at least 1 second")
    if args.once:
        found, note = load_machines()
        if note:
            print(note, file=sys.stderr)
        for line in collect.format_table(
                collect.poll(socket.gethostname(), found)):
            print(line)
        return 0
    mode, mode_note = deploy_mode(args.deploy)
    url, url_note = pipeline_url(args.pipeline)
    curses.wrapper(dashboard, args.interval, mode,
                   join_notes(mode_note, url_note), url)
    return 0


if __name__ == "__main__":
    sys.exit(main())
